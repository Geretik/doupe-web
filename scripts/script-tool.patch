+  color: var(--gray-10);
+}
+
+.doupe-sidebar-role-more {
+  align-self: stretch;
+  width: 36px;
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border: 0;
+  background: none;
+  color: var(--gray-10);
+  cursor: pointer;
+}
+
+.doupe-sidebar-role-more:hover {
+  color: var(--gray-12);
+}
+
+.doupe-sidebar-role-more svg {
+  transition: transform 0.15s;
+}
+
+.doupe-sidebar-role-more.is-open svg {
+  transform: rotate(180deg);
+}
+
+.doupe-sidebar-role-ability {
+  margin: 0;
+  padding: 0 12px 8px 50px;
+  font-size: var(--font-size-1);
+  line-height: 1.4;
+  color: var(--gray-11);
+}
+
+/* the button that brings the sidebar back, where the club's buttons (#doupe-bar, scripts/script-tool-html.mjs)
+   are not: they are bottom right and make room while it is there */
+.doupe-sidebar-open {
+  position: fixed;
+  left: 12px;
+  bottom: 12px;
+  z-index: 999;
+}
+
+.doupe-sidebar-open .rt-Button {
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
+}
+
+html.doupe-sidebar-button #doupe-bar {
+  left: 150px;
+}
+
+html.doupe-sidebar-drawer #doupe-bar {
+  display: none;
+}
+
+@media print {
+  .doupe-sidebar,
+  .doupe-sidebar-backdrop,
+  .doupe-sidebar-open {
+    display: none !important;
+  }
+}
