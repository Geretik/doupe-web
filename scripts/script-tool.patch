+  top: 0;
+  z-index: 1;
+  padding: 6px 12px 4px;
+  background-color: #e8dfc7;
+  font-size: 12px;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.doupe-sidebar-team-count {
+  display: inline-flex;
+  align-items: center;
+  gap: 2px;
+}
+
+.doupe-sidebar-role {
+  /* hundreds of rows: the browser leaves those off screen alone */
+  content-visibility: auto;
+  contain-intrinsic-size: auto 40px;
+  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
+}
+
+.doupe-sidebar-role-main {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 4px 4px 4px 10px;
+  border: 0;
+  background: none;
+  color: inherit;
+  font: inherit;
+  font-size: var(--font-size-2);
+  text-align: start;
+  cursor: pointer;
+}
+
+.doupe-sidebar-role-main[aria-disabled='true'] {
