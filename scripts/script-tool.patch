+/* The sidebar with the characters (RoleSidebar.tsx), only in the club's copy of the tool */
+
+:root {
+  --doupe-sidebar-width: 320px;
+}
+
+/* beside the script on a wide screen (RoleSidebar's WIDE): the page moves aside for it, header included */
+@media screen and (min-width: 1100px) {
+  html.doupe-sidebar-docked body {
+    padding-left: var(--doupe-sidebar-width) !important;
+  }
+}
+
+.doupe-sidebar {
+  position: fixed;
+  top: 0;
+  bottom: 0;
+  left: 0;
+  width: var(--doupe-sidebar-width);
+  display: flex;
+  flex-direction: column;
+  background-image: url(/bg-tile-purple-pattern.webp);
+  background-repeat: repeat;
+  background-size: 100px;
+  color: #f1ead8;
+  /* under the tool's dialogs, which come later in the page */
+  z-index: 0;
+}
+
+/* over the script on a narrow screen, above the tool's sticky header */
+.doupe-sidebar.is-drawer {
+  width: min(var(--doupe-sidebar-width), 88vw);
+  z-index: 1002;
+  box-shadow: 4px 0 16px rgba(0, 0, 0, 0.35);
+}
+
+.doupe-sidebar-backdrop {
+  position: fixed;
+  inset: 0;
+  background: rgba(0, 0, 0, 0.35);
+  z-index: 1001;
+}
+
+.doupe-sidebar-top {
+  padding: 12px 12px 8px 16px;
+}
+
+.doupe-sidebar-top .rt-IconButton {
+  color: #f1ead8;
+}
+
+.doupe-sidebar-title {
+  font-family: 'LHF Unlovable', serif;
+  font-size: 32px;
+  line-height: 1;
+}
+
+.doupe-sidebar-panel {
+  flex: 1;
+  min-height: 0;
+  margin: 0 12px 12px;
+  border-radius: var(--radius-3);
+  background-color: #f1ead8;
+  color: var(--gray-12);
+  overflow: hidden;
+}
+
+.doupe-sidebar-list {
+  flex: 1;
+  min-height: 0;
+  overflow-y: auto;
+  overscroll-behavior: contain;
