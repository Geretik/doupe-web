+}
+
+.doupe-sidebar-role:hover {
+  background-color: rgba(0, 0, 0, 0.05);
+}
+
+.doupe-sidebar-role-main:focus-visible,
+.doupe-sidebar-role-more:focus-visible {
+  outline: 2px solid var(--focus-8);
+  outline-offset: -2px;
+}
+
+.doupe-sidebar-role-main img,
+.doupe-sidebar-role-noimage {
+  width: 32px;
+  height: 32px;
+  flex-shrink: 0;
+  object-fit: contain;
+}
+
+.doupe-sidebar-role-name {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  overflow-wrap: anywhere;
+}
+
+.doupe-sidebar-role.is-in-script .doupe-sidebar-role-name > span {
+  font-weight: 600;
+}
+
+.doupe-sidebar-role-name small {
+  font-size: var(--font-size-1);
+  color: var(--gray-10);
+  line-height: 1.2;
+}
+
+.doupe-sidebar-role-edition {
+  flex-shrink: 0;
