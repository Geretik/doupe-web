diff --git a/apps/botc/src/doupe/RoleSidebar.tsx b/apps/botc/src/doupe/RoleSidebar.tsx
new file mode 100644
index 0000000..dcc6c56
--- /dev/null
+++ b/apps/botc/src/doupe/RoleSidebar.tsx
@@ -0,0 +1,473 @@
+/**
+ * Only in the club's copy of the tool (see roleSets): a sidebar with the characters to browse, like the one of the
+ * official script tool (script.bloodontheclocktower.com). A click adds a character to the script and another takes it
+ * out, without a team's + and its dialog for every one. It picks from the same set as that dialog (roleSets), narrows
+ * them to a team and by a search, Enter adds the first one found, and each one's ability shows on request.
+ * On a wide screen it stays beside the script and can be hidden; on a narrow one it slides over it from a button.
+ */
+import {
+  memo,
+  useCallback,
+  useEffect,
+  useLayoutEffect,
+  useMemo,
+  useRef,
+  useState,
+} from 'react'
+import {
+  Button,
+  Flex,
+  IconButton,
+  Select,
+  Text,
+  TextField,
+} from '@radix-ui/themes'
+import {
+  Check,
+  ChevronDown,
+  ChevronsLeft,
+  Lock,
+  Search,
+  Users,
+  X,
+} from 'lucide-react'
+import { useTranslation } from 'react-i18next'
+import { create } from 'zustand'
+import { persist, createJSONStorage } from 'zustand/middleware'
+import type { Role } from '@/types'
+import { TEAMS, TEAM_CONFIG, Team } from '@/constants'
+import { useTeamLabels } from '@/hooks/useTeamLabels'
+import { roles as baseRoles } from '@/data/roles.en'
+import { useDisplayOptionsStore } from '@/stores/displayOptionsStore'
+import { formatRoleDisplayName } from '@/utils/roleDisplayName'
+import { getProxiedImageUrl } from '@/utils/imageUrl'
+import { RoleSetSelect, useRoleSet } from './roleSets'
+import { useDoupeText } from './text'
+import './roleSidebar.css'
+
+/** From this width the sidebar stays beside the script (roleSidebar.css has the same) */
+const WIDE = '(min-width: 1100px)'
+const ALL_TEAMS = 'all'
+
+const useSidebarStore = create<{
+  /** Hidden on a wide screen by its button; a narrow one opens it over the script each time */
+  hidden: boolean
+  team: string
+  setHidden: (hidden: boolean) => void
+  setTeam: (team: string) => void
+}>()(
+  persist(
+    (set) => ({
+      hidden: false,
+      team: ALL_TEAMS,
+      setHidden: (hidden) => set({ hidden }),
+      setTeam: (team) => set({ team }),
+    }),
+    {
+      name: 'doupe-role-sidebar',
+      storage: createJSONStorage(() => localStorage),
+    },
+  ),
+)
+
+function useMediaQuery(query: string) {
+  const [matches, setMatches] = useState(() => window.matchMedia(query).matches)
+  useEffect(() => {
+    const list = window.matchMedia(query)
+    const change = () => setMatches(list.matches)
+    change()
+    list.addEventListener('change', change)
+    return () => list.removeEventListener('change', change)
+  }, [query])
+  return matches
+}
+
+/** For a search without diacritics and case: "vedma" finds the Vědma */
+const fold = (text: string) =>
+  text.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase()
+
+const englishNames = new Map(baseRoles.map((role) => [role.id, role.name]))
+
+const EDITION_TAGS: Record<string, string> = {
+  tb: 'TB',
+  bmr: 'BMR',
+  snv: 'SnV',
+  carousel: 'Exp',
+  hb: 'HB',
+}
+
+interface RoleSidebarProps {
+  /** The tool's characters, in its language */
+  roles: Role[]
+  /** The characters of the script */
+  scriptRoles: Role[]
+  /** Those the tool keeps in the script (the Bootlegger, the Djinn), by id: why */
+  lockedRoles?: Record<string, string>
+  onAddRole: (role: Role) => void
+  onRemoveRole: (roleId: string) => void
+}
+
+export function RoleSidebar({
+  roles,
+  scriptRoles,
+  lockedRoles,
+  onAddRole,
+  onRemoveRole,
+}: RoleSidebarProps) {
+  const { t, i18n } = useTranslation()
+  const text = useDoupeText()
+  const teamLabels = useTeamLabels()
+  const showEnglishNames = useDisplayOptionsStore(
+    (state) => state.showEnglishNames,
+  )
+  const wide = useMediaQuery(WIDE)
+  const hidden = useSidebarStore((state) => state.hidden)
+  const setHidden = useSidebarStore((state) => state.setHidden)
+  const team = useSidebarStore((state) => state.team)
+  const setTeam = useSidebarStore((state) => state.setTeam)
+  const [drawerOpen, setDrawerOpen] = useState(false)
+  const [search, setSearch] = useState('')
+  const [shownAbilities, setShownAbilities] = useState<Set<string>>(
+    () => new Set(),
+  )
+  const searchRef = useRef<HTMLInputElement>(null)
+
+  const open = wide ? !hidden : drawerOpen
+  const docked = wide && open
+  const roleSet = useRoleSet(roles, open)
+
+  // the script moves aside for the sidebar beside it; the club's buttons (#doupe-bar) make room for this one's
+  useEffect(() => {
+    const classes = document.documentElement.classList
+    classes.toggle('doupe-sidebar-docked', docked)
+    classes.toggle('doupe-sidebar-drawer', !wide && open)
+    classes.toggle('doupe-sidebar-button', !open)
+    return () =>
+      classes.remove(
+        'doupe-sidebar-docked',
+        'doupe-sidebar-drawer',
+        'doupe-sidebar-button',
+      )
+  }, [docked, wide, open])
+
+  const inScript = useMemo(
+    () => new Set(scriptRoles.map((role) => role.id)),
+    [scriptRoles],
+  )
+  const inScriptByTeam = useMemo(() => {
+    const counts = new Map<string, number>()
+    for (const role of scriptRoles) {
+      counts.set(role.team, (counts.get(role.team) ?? 0) + 1)
+    }
+    return counts
+  }, [scriptRoles])
+
+  const query = fold(search.trim())
+  const groups = useMemo(() => {
+    const found = roleSet.roles.filter(
+      (role) =>
+        (team === ALL_TEAMS || role.team === team) &&
+        (!query ||
+          fold(role.name).includes(query) ||
+          fold(englishNames.get(role.id) ?? '').includes(query) ||
+          role.id.toLowerCase().includes(query)),
+    )
+    return TEAMS.map((teamId) => ({
+      team: teamId,
+      roles: found
+        .filter((role) => role.team === teamId)
+        .sort((a, b) => a.name.localeCompare(b.name, i18n.language)),
+    })).filter((group) => group.roles.length > 0)
+  }, [roleSet.roles, team, query, i18n.language])
+
+  // stable for the rows, which are many: they re-render only when their own state changes
+  const handlers = useRef({ onAddRole, onRemoveRole })
+  useLayoutEffect(() => {
+    handlers.current = { onAddRole, onRemoveRole }
+  })
+  const toggleRole = useCallback((role: Role, isInScript: boolean) => {
+    if (isInScript) handlers.current.onRemoveRole(role.id)
+    else handlers.current.onAddRole(role)
+  }, [])
+  const toggleAbility = useCallback((roleId: string) => {
+    setShownAbilities((shown) => {
+      const next = new Set(shown)
+      if (!next.delete(roleId)) next.add(roleId)
+      return next
+    })
+  }, [])
+
+  /** Enter adds the first character found that is not in the script yet, and the search is ready for the next */
+  const addFirst = () => {
+    const role = groups
+      .flatMap((group) => group.roles)
+      .find((r) => !inScript.has(r.id))
+    if (!role) return
+    onAddRole(role)
+    searchRef.current?.select()
+  }
+
+  const close = () => (wide ? setHidden(true) : setDrawerOpen(false))
+
+  if (!open) {
+    return (
+      <div className="doupe-sidebar-open no-print">
+        <Button
+          size="3"
+          radius="full"
+          onClick={() => (wide ? setHidden(false) : setDrawerOpen(true))}
+        >
+          <Users size={18} />
+          {text('Characters')}
+        </Button>
+      </div>
+    )
+  }
+
+  // "Recommended Travellers" are the script's; the sidebar has all of them
+  const teamOptions = TEAMS.map((teamId) => ({
+    team: teamId,
+    label:
+      teamId === Team.Traveler ? text('Travellers') : teamLabels[teamId].label,
+  }))
+  const labelOf = (teamId: string) =>
+    teamOptions.find((option) => option.team === teamId)?.label ?? teamId
+
+  return (
+    <>
+      {!wide && (
+        <div
+          className="doupe-sidebar-backdrop no-print"
+          onClick={() => setDrawerOpen(false)}
+        />
+      )}
+      <aside
+        className={`doupe-sidebar no-print ${wide ? 'is-docked' : 'is-drawer'}`}
+        aria-label={text('Characters')}
+      >
+        <Flex className="doupe-sidebar-top" align="center" justify="between">
+          <span className="doupe-sidebar-title">{text('Characters')}</span>
+          <IconButton
+            variant="ghost"
+            color="gray"
+            size="2"
+            onClick={close}
+            aria-label={wide ? text('Hide the characters') : t('Close')}
+            title={wide ? text('Hide the characters') : t('Close')}
+          >
+            {wide ? <ChevronsLeft size={20} /> : <X size={20} />}
+          </IconButton>
+        </Flex>
+
+        <Flex className="doupe-sidebar-panel" direction="column">
+          <Flex direction="column" gap="2" p="3" pb="2">
+            <RoleSetSelect {...roleSet} />
+            <Flex align="center" gap="2">
+              <Text
+                as="label"
+                htmlFor="doupe-sidebar-team"
+                size="2"
+                color="gray"
+              >
+                {text('Show')}
+              </Text>
+              <Select.Root value={team} onValueChange={setTeam}>
+                <Select.Trigger id="doupe-sidebar-team" style={{ flex: 1 }} />
+                <Select.Content position="popper">
+                  <Select.Item value={ALL_TEAMS}>
+                    {text('All categories')}
+                  </Select.Item>
+                  <Select.Separator />
+                  {teamOptions.map((option) => (
+                    <Select.Item key={option.team} value={option.team}>
+                      {option.label}
+                    </Select.Item>
+                  ))}
+                </Select.Content>
+              </Select.Root>
+            </Flex>
+            <TextField.Root
+              ref={searchRef}
+              placeholder={text('Search… (Enter adds the first)')}
+              value={search}
+              onChange={(e) => setSearch(e.target.value)}
+              onKeyDown={(e) => {
+                if (e.key === 'Enter') {
+                  e.preventDefault()
+                  addFirst()
+                } else if (e.key === 'Escape' && search) {
+                  e.preventDefault()
+                  setSearch('')
+                }
+              }}
+              aria-label={t('Search characters...')}
+            >
+              <TextField.Slot>
+                <Search size={16} />
+              </TextField.Slot>
+              {search && (
+                <TextField.Slot>
+                  <IconButton
+                    size="1"
+                    variant="ghost"
+                    color="gray"
+                    onClick={() => setSearch('')}
+                    aria-label={t('Clear')}
+                  >
+                    <X size={14} />
+                  </IconButton>
+                </TextField.Slot>
+              )}
+            </TextField.Root>
+            {scriptRoles.length === 0 && (
+              <Text size="1" color="gray">
+                {text(
+                  'Click a character to add it to the script, click it again to take it out.',
+                )}
+              </Text>
+            )}
+          </Flex>
+
+          <div className="doupe-sidebar-list">
+            {groups.length === 0 ? (
+              <Text as="p" size="2" color="gray" align="center" m="4">
+                {roleSet.status ?? text('No characters found')}
+              </Text>
+            ) : (
+              groups.map((group) => (
+                <section key={group.team}>
+                  <Flex
+                    className="doupe-sidebar-team"
+                    align="center"
+                    justify="between"
+                    style={{
+                      color: `var(--${TEAM_CONFIG[group.team].color}-11)`,
+                    }}
+                  >
+                    <span>{labelOf(group.team)}</span>
+                    {(inScriptByTeam.get(group.team) ?? 0) > 0 && (
+                      <span
+                        className="doupe-sidebar-team-count"
+                        title={text('In the script')}
+                      >
+                        <Check size={12} />
+                        {inScriptByTeam.get(group.team)}
+                      </span>
+                    )}
+                  </Flex>
+                  {group.roles.map((role) => (
+                    <RoleRow
+                      key={role.id}
+                      role={role}
+                      name={formatRoleDisplayName(role, showEnglishNames)}
+                      edition={EDITION_TAGS[roleSet.edition(role) ?? ''] ?? ''}
+                      collection={roleSet.collection(role)}
+                      isInScript={inScript.has(role.id)}
+                      locked={lockedRoles?.[role.id]}
+                      abilityShown={shownAbilities.has(role.id)}
+                      showLabel={text('Show the ability')}
+                      hideLabel={text('Hide the ability')}
+                      onToggle={toggleRole}
+                      onToggleAbility={toggleAbility}
+                    />
+                  ))}
+                </section>
+              ))
+            )}
+          </div>
+        </Flex>
+      </aside>
+    </>
+  )
+}
+
+const RoleRow = memo(function RoleRow({
+  role,
+  name,
+  edition,
+  collection,
+  isInScript,
+  locked,
+  abilityShown,
+  showLabel,
+  hideLabel,
+  onToggle,
+  onToggleAbility,
+}: {
+  role: Role
+  name: string
+  edition: string
+  collection?: string
+  isInScript: boolean
+  /** Why it cannot be taken out of the script */
+  locked?: string
+  abilityShown: boolean
+  showLabel: string
+  hideLabel: string
+  onToggle: (role: Role, isInScript: boolean) => void
+  onToggleAbility: (roleId: string) => void
+}) {
+  const color = TEAM_CONFIG[role.team as Team]?.color ?? 'gray'
+  const lockedIn = isInScript && !!locked
+
+  return (
+    <div
+      className={`doupe-sidebar-role${isInScript ? ' is-in-script' : ''}`}
+      style={isInScript ? { backgroundColor: `var(--${color}-a4)` } : undefined}
+    >
+      <Flex align="center">
+        <button
+          type="button"
+          className="doupe-sidebar-role-main"
+          onClick={() => !lockedIn && onToggle(role, isInScript)}
+          aria-pressed={isInScript}
+          aria-disabled={lockedIn || undefined}
+          title={lockedIn ? locked : undefined}
+        >
+          {role.image ? (
+            <img
+              src={getProxiedImageUrl(role.image, 64)}
+              alt=""
+              loading="lazy"
+              decoding="async"
+            />
+          ) : (
+            <span className="doupe-sidebar-role-noimage" />
+          )}
+          <span className="doupe-sidebar-role-name">
+            <span>{name}</span>
+            {collection && <small>{collection}</small>}
+          </span>
+          {edition && (
+            <span className="doupe-sidebar-role-edition">{edition}</span>
+          )}
+          {isInScript &&
+            (lockedIn ? (
+              <Lock
+                size={14}
+                style={{ color: 'var(--gray-10)', flexShrink: 0 }}
+              />
+            ) : (
+              <Check
+                size={16}
+                style={{ color: `var(--${color}-11)`, flexShrink: 0 }}
+              />
+            ))}
+        </button>
+        <button
+          type="button"
+          className={`doupe-sidebar-role-more${abilityShown ? ' is-open' : ''}`}
+          onClick={() => onToggleAbility(role.id)}
+          aria-expanded={abilityShown}
+          aria-label={abilityShown ? hideLabel : showLabel}
+          title={abilityShown ? hideLabel : showLabel}
+        >
+          <ChevronDown size={16} />
+        </button>
+      </Flex>
+      {abilityShown && (
+        <p className="doupe-sidebar-role-ability">{role.ability}</p>
+      )}
+    </div>
+  )
+})
diff --git a/apps/botc/src/doupe/roleSets.tsx b/apps/botc/src/doupe/roleSets.tsx
new file mode 100644
index 0000000..45b8470
--- /dev/null
+++ b/apps/botc/src/doupe/roleSets.tsx
@@ -0,0 +1,402 @@
+/**
+ * Only in the copy of the tool run by the DoUPě Olomouc club at skript.doupeol.cz, not in the original: the club's
+ * web applies it as a patch every time it deploys the tool (scripts/script-tool.patch there).
+ *
+ * - The dialog for adding a character and the sidebar with the characters (RoleSidebar) pick from the sets chosen
+ *   by check boxes, any of them together: the editions of the official characters and the homebrew collections of
+ *   the club from botchomebrew.wiki, which the club's web serves with its own Czech translation. The sets chosen are
+ *   the same in both and stay for the next visit.
+ * - "New script": an empty script to add characters to.
+ */
+import { useEffect, useMemo, useState } from 'react'
+import {
+  Button,
+  Checkbox,
+  Flex,
+  Popover,
+  Text,
+  Tooltip,
+} from '@radix-ui/themes'
+import { ChevronDown, FilePlus } from 'lucide-react'
+import { useTranslation } from 'react-i18next'
+import { create } from 'zustand'
+import { persist, createJSONStorage } from 'zustand/middleware'
+import type { Role } from '@/types'
+import { useDoupeText } from './text'
+
+/** The club's web; VITE_DOUPE_URL points the tool at another copy of it (a local one) */
+const DOUPE_URL = (
+  import.meta.env.VITE_DOUPE_URL || 'https://www.doupeol.cz'
+).replace(/\/$/, '')
+
+/** A collection of homebrew characters, each in full as a script's entry */
+interface Collection {
+  key: string
+  name: string
+  author: string | null
+  characters: Role[]
+}
+
+/** The club's web has them in Czech and in English */
+const homebrewLanguage = (language: string | undefined) =>
+  (language ?? 'en').startsWith('cs') ? 'cs' : 'en'
+
+const loading = new Map<string, Promise<Collection[]>>()
+
+/** Loaded once per language; one that failed is tried again by the next dialog or sidebar opened */
+function loadHomebrew(language: string) {
+  let collections = loading.get(language)
+  if (!collections) {
+    collections = fetch(`${DOUPE_URL}/botc/homebrew/${language}`)
+      .then((res) => {
+        if (!res.ok) throw new Error(`${res.status} ${res.statusText}`)
+        return res.json() as Promise<{ collections: Collection[] }>
+      })
+      .then((data) => data.collections)
+    collections.catch(() => loading.delete(language))
+    loading.set(language, collections)
+  }
+  return collections
+}
+
+/** The official characters by edition; the Fabled and Loric are no edition's own and always offered */
+const EDITIONS = [
+  { id: 'tb', name: 'Trouble Brewing', short: 'TB' },
+  { id: 'bmr', name: 'Bad Moon Rising', short: 'BMR' },
+  { id: 'snv', name: 'Sects & Violets', short: 'SnV' },
+  { id: 'carousel', name: 'Experimental characters', short: 'Exp' },
+]
+const EDITION_IDS = EDITIONS.map((edition) => edition.id)
+const isAlwaysOffered = (role: Role) =>
+  role.team === 'fabled' || role.team === 'loric'
+const collectionSet = (key: string) => `hb:${key}`
+/** Every collection the club's web serves, those it adds later too */
+const ALL_COLLECTIONS = 'hb:*'
+
+/** The sets chosen: editions and collections (hb:<key>) */
+const useRoleSetStore = create<{
+  sets: string[]
+  setSets: (sets: string[]) => void
+}>()(
+  persist(
+    (set) => ({
+      sets: EDITION_IDS,
+      setSets: (sets) => set({ sets }),
+    }),
+    {
+      name: 'doupe-role-set',
+      storage: createJSONStorage(() => localStorage),
+      version: 1,
+      // 0: one set at a time - the official characters, an edition, all collections, one, or everything
+      migrate: (persisted, version) => {
+        if (version > 0) return persisted as { sets: string[] }
+        const roleSet = (persisted as { roleSet?: string } | undefined)?.roleSet
+        const sets =
+          roleSet === 'all'
+            ? [...EDITION_IDS, ALL_COLLECTIONS]
+            : roleSet === 'homebrew'
+              ? [ALL_COLLECTIONS]
+              : roleSet &&
+                  (EDITION_IDS.includes(roleSet) || roleSet.startsWith('hb:'))
+                ? [roleSet]
+                : EDITION_IDS
+        return { sets }
+      },
+    },
+  ),
+)
+
+/**
+ * The characters of the sets chosen, for the dialog and the sidebar to filter by team and search, and what to show
+ * about them. The homebrew ones are loaded when a dialog or the sidebar opens.
+ */
+export function useRoleSet(allRoles: Role[], open: boolean) {
+  const { i18n } = useTranslation()
+  const text = useDoupeText()
+  const language = homebrewLanguage(i18n.language)
+  const storedSets = useRoleSetStore((state) => state.sets)
+  const setSets = useRoleSetStore((state) => state.setSets)
+  const [homebrew, setHomebrew] = useState<
+    Record<string, Collection[] | 'error'>
+  >({})
+
+  useEffect(() => {
+    if (!open) return
+    let current = true
+    loadHomebrew(language).then(
+      (collections) =>
+        current && setHomebrew((h) => ({ ...h, [language]: collections })),
+      () => current && setHomebrew((h) => ({ ...h, [language]: 'error' })),
+    )
+    return () => {
+      current = false
+    }
+  }, [open, language])
+
+  const loaded = homebrew[language]
+  const collections = useMemo(
+    () => (Array.isArray(loaded) ? loaded : []),
+    [loaded],
+  )
+  const collectionOf = useMemo(
+    () =>
+      new Map(
+        collections.flatMap((c) => c.characters.map((role) => [role.id, c])),
+      ),
+    [collections],
+  )
+  // once the collections are in, "all of them" is each of them, and one no longer served is no set to pick
+  const sets = useMemo(
+    () =>
+      Array.isArray(loaded)
+        ? storedSets.flatMap((set) =>
+            set === ALL_COLLECTIONS
+              ? collections.map((c) => collectionSet(c.key))
+              : set.startsWith('hb:') &&
+                  !collections.some((c) => collectionSet(c.key) === set)
+                ? []
+                : [set],
+          )
+        : storedSets,
+    [storedSets, loaded, collections],
+  )
+
+  const roles = useMemo(
+    () =>
+      sets.length === 0
+        ? []
+        : [
+            ...allRoles.filter(
+              (role) => isAlwaysOffered(role) || sets.includes(role.edition),
+            ),
+            ...collections
+              .filter((c) => sets.includes(collectionSet(c.key)))
+              .flatMap((c) => c.characters),
+          ],
+    [sets, allRoles, collections],
+  )
+
+  const wantsHomebrew = sets.some((set) => set.startsWith('hb:'))
+  const chosenCollections = sets.filter((set) => set.startsWith('hb:')).length
+  /** Instead of "No characters found" when the sets have none to list */
+  const status =
+    sets.length === 0
+      ? text('Choose at least one set')
+      : wantsHomebrew && loaded === 'error'
+        ? text('The homebrew characters could not be loaded from doupeol.cz')
+        : wantsHomebrew && !loaded
+          ? text('Loading the homebrew characters…')
+          : undefined
+
+  return {
+    sets,
+    setSets,
+    collections,
+    homebrewStatus:
+      loaded === 'error'
+        ? text('The homebrew characters could not be loaded from doupeol.cz')
+        : loaded
+          ? undefined
+          : text('Loading the homebrew characters…'),
+    roles,
+    status,
+    /** The column with the edition: homebrew for those of the collections */
+    edition: (role: Role) => (collectionOf.has(role.id) ? 'hb' : role.edition),
+    /** The collection of a homebrew character, unless only one is chosen */
+    collection: (role: Role) =>
+      chosenCollections === 1 ? undefined : collectionOf.get(role.id)?.name,
+  }
+}
+
+/** Czech has three forms: 1 kolekce, 2-4 kolekce, 5 kolekcí */
+function collectionCount(count: number, cs: boolean) {
+  if (!cs) return `${count} collection${count === 1 ? '' : 's'}`
+  return `${count} ${count >= 5 || count === 0 ? 'kolekcí' : 'kolekce'}`
+}
+
+/** The sets to pick characters from, any of the editions and collections, in a box with check boxes */
+export function RoleSetSelect({
+  sets,
+  setSets,
+  collections,
+  homebrewStatus,
+}: Pick<
+  ReturnType<typeof useRoleSet>,
+  'sets' | 'setSets' | 'collections' | 'homebrewStatus'
+>) {
+  const { i18n } = useTranslation()
+  const text = useDoupeText()
+  const cs = (i18n.language ?? 'en').startsWith('cs')
+
+  const has = (set: string) => sets.includes(set)
+  const collectionSets = collections.map((c) => collectionSet(c.key))
+  /** All the collections are kept as all of them, so that those the club adds later come too */
+  const save = (chosen: string[]) =>
+    setSets(
+      collectionSets.length > 0 &&
+        collectionSets.every((set) => chosen.includes(set))
+        ? [...chosen.filter((set) => !set.startsWith('hb:')), ALL_COLLECTIONS]
+        : chosen,
+    )
+  const toggle = (set: string, on: boolean) =>
+    save(on ? [...sets, set] : sets.filter((s) => s !== set))
+  const editionsChosen = EDITION_IDS.filter(has)
+  const collectionsChosen = sets.filter((set) => set.startsWith('hb:'))
+  const allCollections = collectionSets.length > 0 && collectionSets.every(has)
+  /** A group's box: checked, unchecked, or some of it */
+  const groupState = (chosen: number, all: boolean) =>
+    all ? true : chosen > 0 ? ('indeterminate' as const) : false
+  const setGroup = (group: string[], on: boolean) =>
+    save([...sets.filter((set) => !group.includes(set)), ...(on ? group : [])])
+
+  const official =
+    editionsChosen.length === EDITION_IDS.length
+      ? text('Official')
+      : EDITIONS.filter((e) => has(e.id))
+          .map((e) => e.short)
+          .join(', ')
+  const homebrew = allCollections
+    ? 'Homebrew'
+    : collectionsChosen.length === 1
+      ? (collections.find((c) => collectionSet(c.key) === collectionsChosen[0])
+          ?.name ?? collectionCount(1, cs))
+      : collectionsChosen.length > 1
+        ? collectionCount(collectionsChosen.length, cs)
+        : ''
+  const summary =
+    editionsChosen.length === EDITION_IDS.length && allCollections
+      ? text('All characters')
+      : [official, homebrew].filter(Boolean).join(' + ') ||
+        text('Nothing chosen')
+
+  return (
+    <Flex align="center" gap="2">
+      <Text as="label" htmlFor="doupe-role-set" size="2" color="gray">
+        {text('Sets')}
+      </Text>
+      <Popover.Root>
+        <Popover.Trigger>
+          <Button
+            id="doupe-role-set"
+            variant="surface"
+            color="gray"
+            style={{ flex: 1, minWidth: 0, justifyContent: 'space-between' }}
+          >
+            <span
+              style={{
+                overflow: 'hidden',
+                textOverflow: 'ellipsis',
+                whiteSpace: 'nowrap',
+                color: 'var(--gray-12)',
+              }}
+            >
+              {summary}
+            </span>
+            <ChevronDown size={14} style={{ flexShrink: 0 }} />
+          </Button>
+        </Popover.Trigger>
+        <Popover.Content
+          align="start"
+          size="1"
+          style={{
+            width: 'max(var(--radix-popover-trigger-width), 260px)',
+            maxWidth: 'calc(100vw - 24px)',
+            maxHeight:
+              'min(70vh, var(--radix-popover-content-available-height))',
+            overflowY: 'auto',
+          }}
+        >
+          <Flex direction="column" gap="1">
+            <Text as="label" size="2" weight="bold">
+              <Flex gap="2" align="center">
+                <Checkbox
+                  checked={groupState(
+                    editionsChosen.length,
+                    editionsChosen.length === EDITION_IDS.length,
+                  )}
+                  onCheckedChange={(on) => setGroup(EDITION_IDS, on === true)}
+                />
+                {text('Official characters')}
+              </Flex>
+            </Text>
+            {EDITIONS.map((edition) => (
+              <Text as="label" size="2" key={edition.id} ml="4">
+                <Flex gap="2" align="center">
+                  <Checkbox
+                    checked={has(edition.id)}
+                    onCheckedChange={(on) => toggle(edition.id, on === true)}
+                  />
+                  {text(edition.name)}
+                </Flex>
+              </Text>
+            ))}
+
+            <Text as="label" size="2" weight="bold" mt="2">
+              <Flex gap="2" align="center">
+                <Checkbox
+                  disabled={collections.length === 0}
+                  checked={groupState(collectionsChosen.length, allCollections)}
+                  onCheckedChange={(on) =>
+                    setGroup(collectionSets, on === true)
+                  }
+                />
+                Homebrew (botchomebrew.wiki)
+              </Flex>
+            </Text>
+            {homebrewStatus ? (
+              <Text size="1" color="gray" ml="4">
+                {homebrewStatus}
+              </Text>
+            ) : (
+              collections.map((c) => (
+                <Text as="label" size="2" key={c.key} ml="4">
+                  <Flex gap="2" align="center">
+                    <Checkbox
+                      checked={has(collectionSet(c.key))}
+                      onCheckedChange={(on) =>
+                        toggle(collectionSet(c.key), on === true)
+                      }
+                    />
+                    <span>
+                      {c.name} <Text color="gray">({c.characters.length})</Text>
+                    </span>
+                  </Flex>
+                </Text>
+              ))
+            )}
+
+            <Text size="1" color="gray" mt="2">
+              {text('The Fabled and Loric are always offered.')}
+            </Text>
+          </Flex>
+        </Popover.Content>
+      </Popover.Root>
+    </Flex>
+  )
+}
+
+/** An empty script, given its name in the tool's language, loaded like a pasted one */
+export function NewScriptButton({
+  onCreate,
+  hasScript,
+}: {
+  onCreate: (json: string) => void
+  hasScript: boolean
+}) {
+  const text = useDoupeText()
+
+  return (
+    <Tooltip content={text('An empty script to add characters to')}>
+      <Button
+        onClick={() =>
+          onCreate(JSON.stringify([{ id: '_meta', name: text('New script') }]))
+        }
+        variant={hasScript ? 'soft' : 'solid'}
+      >
+        <FilePlus size={16} />
+        <span className="hidden md:inline">{text('New script')}</span>
+        <span className="md:hidden">{text('New')}</span>
+      </Button>
+    </Tooltip>
+  )
+}
