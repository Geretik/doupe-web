+/**
+ * The texts of the club's additions (src/doupe) in Czech, the club's language; any other language of the tool gets
+ * the English ones. Kept here rather than in the tool's locales, which are upstream's.
+ */
+import { useTranslation } from 'react-i18next'
+
+const CS: Record<string, string> = {
+  // roleSets
+  'Sets': 'Sady',
+  'Official characters': 'Oficiální postavy',
+  'Official': 'Oficiální',
+  'Experimental characters': 'Experimentální postavy',
+  'All characters': 'Všechny postavy',
+  'Nothing chosen': 'Nic nevybráno',
+  'Choose at least one set': 'Vyber aspoň jednu sadu',
+  'The Fabled and Loric are always offered.':
+    'Báje a Loric jsou v nabídce vždy.',
+  'Loading the homebrew characters…': 'Načítám homebrew postavy…',
+  'The homebrew characters could not be loaded from doupeol.cz':
+    'Homebrew postavy se nepodařilo načíst z doupeol.cz',
+  'New script': 'Nový script',
+  'New': 'Nový',
+  'An empty script to add characters to':
+    'Prázdný script, do kterého přidáš postavy',
+  // RoleSidebar
+  'Characters': 'Postavy',
+  'Show': 'Zobrazit',
+  'All categories': 'Všechny kategorie',
+  'Travellers': 'Pocestní',
+  'Search… (Enter adds the first)': 'Hledat… (Enter přidá první)',
+  'Click a character to add it to the script, click it again to take it out.':
+    'Kliknutím postavu přidáš do scriptu, dalším kliknutím ji odebereš.',
+  'In the script': 'Ve scriptu',
+  'Show the ability': 'Ukázat schopnost',
+  'Hide the ability': 'Skrýt schopnost',
+  'Hide the characters': 'Skrýt postavy',
+  'No characters found': 'Žádná postava neodpovídá',
+}
+
+export function useDoupeText() {
+  const { i18n } = useTranslation()
+  const cs = (i18n.language ?? 'en').startsWith('cs')
+  return (text: string) => (cs && CS[text]) || text
+}
