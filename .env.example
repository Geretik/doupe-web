# Postgres connection string (Neon / Vercel Postgres / Supabase / local)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Resend (https://resend.com) - when empty, e-mails are only logged to the console
RESEND_API_KEY=
EMAIL_FROM="Blood on the Clocktower CZ <registrace@example.cz>"
# Volitelné (vývoj bez ověřené domény): všechny e-maily se doručí sem, původní příjemce je v předmětu.
# EMAIL_REDIRECT_TO=bezdek.michal@gmail.com
# Organisers' inbox: Reply-To of all e-mails and the contact on /ochrana-udaju (the sender address has no mailbox)
CONTACT_EMAIL=

# Public URL of the site, used in e-mail links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public site name (header, e-mails, calendar feeds)
NEXT_PUBLIC_SITE_NAME="DoUPě Olomouc"

# Bootstrap password: only used to create the very first organiser account at /admin/login.
# Every other account is created through an invitation link from /admin/ucty.
ADMIN_PASSWORD=change-me
# Random secret used to sign the admin cookie (e.g. `openssl rand -hex 32`)
ADMIN_SECRET=change-me-too

# Secret for the daily reminder cron (Vercel sends it as `Authorization: Bearer …`), e.g. `openssl rand -hex 32`
CRON_SECRET=

# Optional: Discord webhook URL for announcing new sessions (Server settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=
# Optional: 1 = also post "N spots left" to that channel two days before a game that is not full (off by default)
DISCORD_SPOTS_LEFT=
# Organisers-only channel for alerts (late cancellations with nickname and reason, failed e-mails); never the public one
DISCORD_ALERTS_WEBHOOK_URL=

# Optional: GameUPC production key (ask by e-mail at gameupc.com); the lending desk asks it which game an unknown
# bar code is. Without it the desk asks GameUPC's public test server.
GAMEUPC_API_KEY=
